#!/bin/sh

SRCDIR="$(cd $(dirname $0); pwd)"
test "$SRCDIR" = "$(pwd)" && SRCDIR=.

cat > config.mak << EOF
CXX = g++
LD = g++
STRIP = strip
CXXFLAGS = -std=c++11 -Wall -O3 -ffast-math -msse2 -mfpmath=sse -I. -I\$(SRCDIR)/include
LDFLAGS = -shared -Wl,--dll,--add-stdcall-alias
LIBS = -lfftw3f
SRCDIR = $SRCDIR
LIBNAME = DePan.dll
libdir = /usr/local/lib/vapoursynth
EOF

echo "Configured for maximum static build."
echo "Now run: make -f GNUmakefile clean && make -f GNUmakefile -j2"